{
  "name": "nexesocial-security-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Firestore security rules tests for NexeSocial",
  "scripts": {
    "v2:build": "node v2/scripts/build.mjs",
    "v2:check": "node --test v2/tests/base.test.mjs",
    "v2:dev": "firebase --config v2/firebase.json --project demo-nexesocial-v2 emulators:start --only auth,firestore,hosting",
    "v2:seed": "node v2/scripts/seed.mjs",
    "v2:test": "firebase --config v2/firebase.json --project demo-nexesocial-v2 emulators:exec --only firestore \"node v2/tests/permissions.cjs\"",
    "audit:static": "node scripts/audit-static.mjs --check",
    "audit:rules": "node scripts/audit-rules.cjs --check",
    "test:structure": "node --test scripts/program-structure.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/test-firestore-rules.js\"",
    "ops:readiness": "powershell -ExecutionPolicy Bypass -File .\\ops-readiness.ps1",
    "ops:routes": "powershell -ExecutionPolicy Bypass -File .\\demo-routes-check.ps1",
    "ops:preflight": "powershell -ExecutionPolicy Bypass -File .\\ops-preflight.ps1",
    "ops:start": "powershell -ExecutionPolicy Bypass -File .\\ops-start.ps1",
    "demo:readiness": "powershell -ExecutionPolicy Bypass -File .\\demo-readiness.ps1",
    "demo:routes": "powershell -ExecutionPolicy Bypass -File .\\demo-routes-check.ps1",
    "demo:preflight": "powershell -ExecutionPolicy Bypass -File .\\demo-preflight.ps1",
    "demo:freeze": "powershell -ExecutionPolicy Bypass -File .\\demo-freeze.ps1",
    "demo:launch": "powershell -ExecutionPolicy Bypass -File .\\demo-launch.ps1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "esbuild": "0.28.2",
    "firebase": "^10.14.1",
    "firebase-tools": "15.30.0"
  }
}
