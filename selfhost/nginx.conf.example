# Adaptar al dominio y certificados existentes. No sustituir otras webs.
server {
    listen 443 ssl;
    server_name nexesocial-pruebas.example.org;
    ssl_certificate /ruta/al/certificado/fullchain.pem;
    ssl_certificate_key /ruta/al/certificado/privkey.pem;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:4080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
